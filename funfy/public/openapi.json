{
  "openapi": "3.0.0",
  "info": {
    "title": "Funfy AI Sticker & Image Studio API",
    "description": "API endpoints for background removal, image resolution upscaling, image component dissection, and custom sticker generation.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://funfy.vercel.app",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/remove-bg": {
      "post": {
        "operationId": "removeBackground",
        "summary": "Remove background from an image",
        "description": "Removes background from an image URL or Base64 data string and returns transparent PNG result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveBgRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Background removed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemoveBgResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/enhance": {
      "post": {
        "operationId": "enhanceImage",
        "summary": "Enhance photo quality and resolution",
        "description": "Upscales photo resolution to 2K, 4K, or 8K and sharpens image details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnhanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image enhanced successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnhanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/dissect": {
      "post": {
        "operationId": "dissectImage",
        "summary": "Dissect image into sticker components",
        "description": "Extracts cut-out component elements from an image into isolated stickers.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DissectRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image dissected successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DissectResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sticker-generate": {
      "post": {
        "operationId": "generateSticker",
        "summary": "Generate a custom text or shape sticker",
        "description": "Creates a custom sticker graphic with chosen text, font, color, and shape style.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StickerGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sticker generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StickerGenerateResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RemoveBgRequest": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "Public URL of the input image"
          },
          "imageBase64": {
            "type": "string",
            "description": "Base64 encoded string of the input image"
          }
        }
      },
      "RemoveBgResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "resultImageBase64": {
            "type": "string"
          }
        }
      },
      "EnhanceRequest": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string"
          },
          "imageBase64": {
            "type": "string"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "2k",
              "4k",
              "8k"
            ],
            "default": "4k"
          },
          "sharpness": {
            "type": "integer",
            "default": 60
          },
          "denoise": {
            "type": "integer",
            "default": 30
          }
        }
      },
      "EnhanceResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "resultImageBase64": {
            "type": "string"
          }
        }
      },
      "DissectRequest": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string"
          },
          "imageBase64": {
            "type": "string"
          },
          "sensitivity": {
            "type": "integer",
            "default": 50
          }
        }
      },
      "DissectResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "componentsCount": {
            "type": "integer"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "resultImageBase64": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "StickerGenerateRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "font": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          }
        }
      },
      "StickerGenerateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "resultImageBase64": {
            "type": "string"
          }
        }
      }
    }
  }
}
